# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

# ── Anthropic (required for edge extraction + demo synthesis) ──
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (required to write ingested chunks + edges) ──
# Get from https://supabase.com/dashboard/project/ewugluzfpgsonifbpeau/settings/api
SUPABASE_URL=https://ewugluzfpgsonifbpeau.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Anon key is only needed for clients (CLI, dash page). Ingest uses service_role.
SUPABASE_ANON_KEY=eyJhbGc...
